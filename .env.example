# Kairix environment configuration
# Copy this file: cp .env.example .env
# Then edit with your credentials.
# Fields marked REQUIRED must be set before starting kairix.
#
# Docker Compose reads this file two ways:
#   - env_file: .env — every KEY=VALUE below lands inside the kairix container
#   - ${...} interpolation — KAIRIX_NEO4J_PASSWORD, KAIRIX_HOST_PORT and
#     KAIRIX_MCP_BIND_HOST shape the compose file itself
# Pip installs read the same names from your shell or $KAIRIX_SECRETS_FILE.
# For production with a cloud secrets manager (Azure Key Vault, AWS Secrets
# Manager, GCP Secret Manager, 1Password, ECS, Cloud Run, AKS CSI), see
# docs/operations/secrets-configuration.md — the resolution order, canonical
# naming, and per-provider recipes all live there.

# ── LLM Provider ────────────────────────────────────────────────────────────

# REQUIRED — your LLM API key and endpoint
KAIRIX_PROVIDER_LLM_ENDPOINT=https://your-resource.openai.azure.com
KAIRIX_PROVIDER_LLM_API_KEY=your-api-key-here

# OPTIONAL — override the model name (a sensible default is used otherwise)
# KAIRIX_PROVIDER_LLM_MODEL=gpt-4o-mini

# OPTIONAL — separate embed provider (falls back to LLM provider if not set)
# KAIRIX_PROVIDER_EMBED_ENDPOINT=https://openrouter.ai/api/v1
# KAIRIX_PROVIDER_EMBED_API_KEY=your-embed-api-key
# KAIRIX_PROVIDER_EMBED_MODEL=qwen/qwen3-embedding-8b
# KAIRIX_EMBED_DIMS=4096

# OPTIONAL — Azure API version (default: 2024-12-01-preview)
# KAIRIX_AZURE_API_VERSION=2024-12-01-preview

# ── Neo4j (knowledge graph for people / company queries) ─────────────────────

# REQUIRED for the bundled neo4j container — it refuses to start with an
# empty password. The default below is fine on a laptop. Change it for
# anything beyond a laptop: a VM, a shared host, or any machine other
# people can reach.
KAIRIX_NEO4J_PASSWORD=kairix-local-dev

# ── Network (read by docker-compose.yml) ─────────────────────────────────────

# OPTIONAL — host port for the kairix container (default 8080). Set this
# when another service (reverse proxy, other app) already owns host 8080.
# Compose binds ${KAIRIX_MCP_BIND_HOST:-127.0.0.1}:${KAIRIX_HOST_PORT:-8080}:8080.
# KAIRIX_HOST_PORT=8090

# OPTIONAL — host interface for the kairix port (default 127.0.0.1 = this
# machine only). The MCP server has no authentication. Set 0.0.0.0 ONLY if
# an auth-enforcing reverse proxy (caddy / nginx / Authentik) or a private
# network sits in front of it.
# KAIRIX_MCP_BIND_HOST=127.0.0.1

# ── Kairix paths (defaults work with Docker Compose) ─────────────────────────

# Compose already sets KAIRIX_DOCUMENT_ROOT=/data/documents and mounts your
# ./documents folder there. On the host, symlink your documents folder:
#   ln -s ~/my-notes ./documents
# KAIRIX_DOCUMENT_ROOT=/data/documents
# OPTIONAL — has sensible defaults
# KAIRIX_DB_PATH=/data/kairix/index.sqlite

# ── Secrets source (production / cloud-secrets-manager paths) ───────────────

# OPTIONAL — Azure Key Vault name. When set, kairix resolves any missing
# secret by falling back to `az keyvault secret show --vault-name $KAIRIX_KV_NAME`.
# Most production deployments populate /run/secrets/kairix.env via a systemd
# sidecar instead (avoids 200-500ms az latency per secret); the KV name is
# still useful for `kairix secrets verify` and rotation runbooks.
# See docs/operations/secrets-configuration.md.
# KAIRIX_KV_NAME=your-kv-name

# OPTIONAL — path to the secrets bundle file (KEY=VALUE pairs). Default
# /run/secrets/kairix.env in Docker; ~/.config/kairix/secrets/kairix.env (or
# $XDG_CONFIG_HOME/kairix/secrets/kairix.env) for pip installs. The file's
# contents are added to process env on startup; per-process env vars still
# win (so you can override one value at run time without editing the file).
# KAIRIX_SECRETS_FILE=/run/secrets/kairix.env
