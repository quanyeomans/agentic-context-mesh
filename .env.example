# Kairix environment configuration
# Copy this file: cp .env.example .env
# Then edit with your credentials.
# Fields marked REQUIRED must be set before starting kairix.
#
# This file covers the local-dev / single-machine path: KEY=VALUE pairs read
# directly by docker-compose (or by `kairix mcp serve` via $KAIRIX_SECRETS_FILE
# on pip installs). For production with a cloud secrets manager
# (Azure Key Vault, AWS Secrets Manager, GCP Secret Manager, 1Password, ECS,
# Cloud Run, AKS CSI), see docs/operations/secrets-configuration.md — the
# resolution order, canonical naming, and per-provider recipes all live there.

# ── LLM Provider ────────────────────────────────────────────────────────────

# REQUIRED — your LLM API key and endpoint
KAIRIX_LLM_ENDPOINT=https://your-resource.openai.azure.com
KAIRIX_LLM_API_KEY=your-api-key-here

# OPTIONAL — override model names (sensible defaults used otherwise)
# KAIRIX_LLM_MODEL=gpt-4o-mini

# OPTIONAL — separate embed provider (falls back to LLM provider if not set)
# KAIRIX_EMBED_API_KEY=your-embed-api-key
# KAIRIX_EMBED_ENDPOINT=https://openrouter.ai/api/v1
# KAIRIX_EMBED_MODEL=qwen/qwen3-embedding-8b
# KAIRIX_EMBED_DIMS=4096

# OPTIONAL — Azure API version (default: 2024-12-01-preview)
# KAIRIX_AZURE_API_VERSION=2024-12-01-preview

# ── Neo4j (optional — knowledge graph for people/company queries) ────────────

# OPTIONAL — set a strong password for your Neo4j instance
KAIRIX_NEO4J_PASSWORD=

# ── Reverse-proxy port mapping ──────────────────────────────────────────────

# OPTIONAL — host port for the kairix container. Default 8080.
# Set this when your reverse proxy (caddy / nginx / Cloudflared) already
# owns host 8080 — the compose file binds 127.0.0.1:${KAIRIX_HOST_PORT:-8080}:8080
# so setting this env-overrides the host side without needing a
# docker-compose.override.yml (whose `ports:` array would merge rather
# than replace the base file's entry, causing port collisions). See #331.
# KAIRIX_HOST_PORT=8090

# ── Kairix paths (defaults work with Docker Compose) ─────────────────────────

# KAIRIX_DOCUMENT_ROOT=/data/vault  # Document store root inside container
# (KAIRIX_VAULT_ROOT still works but is deprecated)
# On host, symlink your documents: ln -s ~/my-notes ./documents
# OPTIONAL — has sensible defaults
# KAIRIX_DB_PATH=/data/kairix/index.sqlite

# ── Secrets source (production / cloud-secrets-manager paths) ───────────────

# OPTIONAL — Azure Key Vault name. When set, kairix resolves any missing
# secret by falling back to `az keyvault secret show --vault-name $KAIRIX_KV_NAME`.
# Most production deployments populate /run/secrets/kairix.env via a systemd
# sidecar instead (avoids 200-500ms az latency per secret); the KV name is
# still useful for `kairix secrets verify` and rotation runbooks.
# See docs/operations/secrets-configuration.md.
# KAIRIX_KV_NAME=your-kv-name

# OPTIONAL — path to the secrets bundle file (KEY=VALUE pairs). Default
# /run/secrets/kairix.env in Docker; ~/.config/kairix/secrets/kairix.env (or
# $XDG_CONFIG_HOME/kairix/secrets/kairix.env) for pip installs. The file's
# contents are added to process env on startup; per-process env vars still
# win (so you can override one value at run time without editing the file).
# KAIRIX_SECRETS_FILE=/run/secrets/kairix.env
