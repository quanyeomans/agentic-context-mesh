[Unit]
Description=Fetch kairix secrets from Azure Key Vault into /run/secrets
Documentation=file:///opt/kairix/app/docs/operations/secrets-configuration.md
After=network-online.target
Wants=network-online.target
Before=docker-compose@kairix.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/kairix-fetch-secrets
ExecStart=/opt/kairix/bin/fetch-secrets.sh

# Re-run when manually requested (e.g. after secret rotation):
#   sudo systemctl restart kairix-fetch-secrets

[Install]
WantedBy=multi-user.target
