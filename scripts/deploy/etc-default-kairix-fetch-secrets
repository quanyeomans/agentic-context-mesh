# /etc/default/kairix-fetch-secrets
# Sourced by /opt/kairix/bin/fetch-secrets.sh via the systemd unit
# (kairix-fetch-secrets.service) — set the Azure Key Vault name that
# fetch-secrets pulls every kairix-* secret from.
#
# Install:
#   sudo install -m 0644 scripts/deploy/etc-default-kairix-fetch-secrets \
#       /etc/default/kairix-fetch-secrets
#   sudo $EDITOR /etc/default/kairix-fetch-secrets  # replace with your vault name
#
# Then enable the unit:
#   sudo systemctl enable --now kairix-fetch-secrets.service
KAIRIX_KV_NAME=kv-tc-agents
